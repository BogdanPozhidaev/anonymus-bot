    "definitions": {
        "api.changePasswordRequest": {
            "type": "object",
            "required": [
                "current_password",
                "new_password"
            ],
            "properties": {
                "current_password": {
                    "type": "string"
                },
                "new_password": {
                    "type": "string"
                }
            }
        },
        "api.createSessionRequest": {
            "type": "object",
            "required": [
                "title"
            ],
            "properties": {
                "language": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "api.issueRecoveryCodesRequest": {
            "type": "object",
            "required": [
                "code",
                "password"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "maxLength": 16
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "api.loginRequest": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "api.loginResponse": {
            "type": "object",
            "properties": {
                "pending_token": {
                    "type": "string"
                },
                "session_token": {
                    "type": "string"
                },
                "status": {
                    "description": "\"totp_required\" | \"totp_setup_required\" | \"ok\"",
                    "type": "string"
                },
                "totp_qr_url": {
                    "type": "string"
                },
                "totp_secret": {
                    "type": "string"
                }
            }
        },
        "api.recoverTOTPRequest": {
            "type": "object",
            "required": [
                "pending_token",
                "recovery_code"
            ],
            "properties": {
                "pending_token": {
                    "type": "string"
                },
                "recovery_code": {
                    "type": "string",
                    "maxLength": 64
                }
            }
        },
        "api.sendAsOperatorRequest": {
            "type": "object",
            "required": [
                "content",
                "content_type",
                "impersonated_role"
            ],
            "properties": {
                "content": {
                    "type": "string"
                },
                "content_type": {
