FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /retention ./cmd/retention

FROM alpine:3.19

RUN apk add --no-cache ca-certificates

COPY --from=builder /retention /retention
COPY --chmod=755 cmd/retention/entrypoint.sh /entrypoint.sh

USER 10001:10001
ENTRYPOINT ["/entrypoint.sh"]
