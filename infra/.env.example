# Postgres
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_DB=mediator_bot
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend
BACKEND_PORT=8080
# Absolute path to the internal API token file stored outside the repository.
INTERNAL_API_TOKEN_FILE=
BOT_INTERNAL_TOKEN_FILE=

TELEGRAM_BOT_TOKEN=
OPERATOR_GROUP_CHAT_ID=
PANEL_BASE_URL=http://localhost
PANEL_HTTP_BIND=0.0.0.0
PANEL_HTTP_PORT=80
PANEL_HTTPS_PORT=443
PANEL_HTTPS_BIND=0.0.0.0
TLS_CERT_DIR=
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_ACTIVE_VERSION=1
# Additional keys for rotation, as comma-separated version:base64 pairs.
PII_ENCRYPTION_KEYS=
RETENTION_RUN_HOUR=03
RETENTION_PII_MONTHS=3
RETENTION_MESSAGE_MONTHS=12

# Optional moderation policy. See docs/MODERATION.md.
MODERATION_DISABLED_RULES=
MODERATION_AUTO_PAUSE=false

# Public panel identification. Supply the bot username without @.
PANEL_BOT_USERNAME=
PANEL_PRODUCT_NAME=
PANEL_PRIMARY_COLOR=blue
PANEL_COLOR_SCHEME=light
PANEL_LOGIN_SUBTITLE_RU=
PANEL_LOGIN_SUBTITLE_EN=
BOT_ORGANIZATION_NAME=
BOT_JOINED_TEXT_RU=
BOT_JOINED_TEXT_EN=
BOT_REQUEST_RECEIVED_TEXT_RU=
BOT_REQUEST_RECEIVED_TEXT_EN=

# Optional monitoring override. Keep both secret files outside the repository.
METRICS_TOKEN_FILE=
GRAFANA_ADMIN_PASSWORD_FILE=
GRAFANA_PORT=3000

# Optional webhook override. Use TLS and a dedicated secret file.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET_FILE=

# Optional OIDC override. Keep the credentials and operator map outside Git.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URL=
OIDC_CLIENT_SECRET_FILE=
OIDC_OPERATOR_MAP_FILE=
